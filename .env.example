# Required for NVD component CVE lookup in batch and for --scanner nvd/both/auto (when key is set).
# Free key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional: standalone CVE scans can use Grype instead (install grype; --scanner auto|grype).
# Batch CSAF generation uses NVD only unless you pass --no-nvd.

# Optional: raises GitHub API rate limit for TianoCore GHSA feed
GITHUB_TOKEN=

# Optional: default EDK II clone for --edk2-dir (see docs/edk2-checkout.md)
# EDK2_DIR=C:\temp\test\SBOM4EDK2\edk2
